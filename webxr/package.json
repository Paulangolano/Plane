{
  "name": "skyreach-vr-webxr",
  "version": "1.0.0",
  "private": true,
  "description": "Skyreach VR - an arcade VR flight sim for Meta Quest, built with WebXR and Three.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:quest": "vite --host --mode quest",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "vite build && node --test --test-concurrency=1 --test-timeout=180000 \"tests/e2e/*.test.js\""
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "iwer": "2.7.0",
    "vite": "8.3.5"
  }
}
