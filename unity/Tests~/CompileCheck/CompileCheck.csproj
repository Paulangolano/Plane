<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles every runtime script against Unity's engine reference assemblies (from NuGet),
       with small stubs for the uGUI and Input System packages. Catches API/typing mistakes
       without opening the Unity editor. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>ENABLE_INPUT_SYSTEM;SKYREACH_INPUT_SYSTEM</DefineConstants>
    <NoWarn>CS0649;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Skyreach/Scripts/**/*.cs" />
    <Compile Include="UGuiStub.cs;InputSystemStub.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
  </ItemGroup>
</Project>
